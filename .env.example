# Copy to .env. The defaults start db + api + miniapp locally without any secrets. Never commit .env.

# --- MAX bot ---
# off — API and mini-app without the bot (default here): the bot for the review runs on the stand via webhook.
# polling — your own bot locally; polling with the stand bot's token removes the stand's webhook subscription
#   (MAX delivers updates one way only). webhook — public HTTPS stand.
BOT_MODE=off
# With BOT_MODE=off this is only the key that signs and checks local test initData
# (dist/scripts/sign-init-data.js); it is not a MAX token. For polling put the token of your own
# test bot: polling with the stand bot's token (@t750_hakaton_max_bot) removes the stand's webhook
# until the stand's api restarts. webhook — the stand's token. A real token is a secret: never commit it.
MAX_BOT_TOKEN=local-review-not-a-real-token
# Webhook mode only: public HTTPS origin of the API (port 443) and a shared secret [A-Za-z0-9-]{5,256}.
WEBHOOK_URL=
WEBHOOK_SECRET=
# Optional: value for `web_app` in "open mini-app" buttons (defaults to the bot username).
MAX_WEB_APP=
# Reminders: delay of the "next step" reminder after the route changes (default 72000 = 20 h;
# set 60 for a demo) and how often the queue is polled.
REMINDER_DELAY_SECONDS=72000
REMINDER_POLL_SECONDS=30

# --- Optional «Объясни проще» (LLM). Off by default; the main scenario never depends on it. ---
# Any OpenAI-compatible chat completions endpoint (e.g. a GigaChat or YandexGPT compatible gateway).
LLM_ENABLED=false
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=10000

# --- «Карта» tab: location index of the rules packs (content/<pack>/location-index.json, OpenStreetMap data). ---
# On by default; false turns the map off (the snapshot endpoint answers 404, /api/config lists no index).
# A missing or invalid snapshot only turns the map off for its pack and is logged; the API keeps running.
LOCATION_INDEX_ENABLED=true

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=otkryvay
# Local throwaway database only. On a server set your own strong password (secret).
POSTGRES_PASSWORD=local-only-password
POSTGRES_DB=otkryvay

# --- API ---
API_PORT=3000
LOG_LEVEL=info
# How long signed mini-app launch data (initData) stays valid, seconds.
INIT_DATA_MAX_AGE_SECONDS=86400

# --- Mini-app ---
MINIAPP_PORT=8080

# --- Tests (docker compose --profile test) ---
# Host port of the throwaway test database (db-test). Host-side `pnpm test` expects 55439
# unless TEST_DATABASE_URL is set.
TEST_DB_PORT=55439

# --- Public stand only (compose.stand.yaml) ---
# Domain with a DNS A record pointing at the server; Caddy issues TLS for it.
STAND_DOMAIN=
